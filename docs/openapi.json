{
  "openapi": "3.0.3",
  "info": {
    "title": "ClientSphere Enterprise CRM & Workflow Automation API",
    "description": "Comprehensive REST API specification for ClientSphere Enterprise CRM Platform, covering leads, multi-company contacts, collaborative opportunities, Kanban pipelines, activity timelines, workflow automation, and sandbox integrations.",
    "version": "1.0.0",
    "contact": {
      "name": "Nitin Sharma",
      "email": "nitin.sharma@clientsphere.io"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Current origin through the frontend proxy"
    },
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local API"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT Bearer token obtained from /auth/login"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "API Key for Webhook & Lead-Capture endpoints"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMINISTRATOR",
              "SALES_MANAGER",
              "SALES_REPRESENTATIVE",
              "MARKETING_USER",
              "SUPPORT_USER"
            ]
          },
          "department": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          }
        }
      },
      "Lead": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "jobTitle": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "CONTACTED",
              "QUALIFIED",
              "UNQUALIFIED",
              "CONVERTED"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "WEBSITE",
              "REFERRAL",
              "COLD_OUTREACH",
              "INBOUND_FORM",
              "TRADE_SHOW",
              "PARTNER",
              "CSV_IMPORT"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "priorityTier": {
            "type": "string",
            "enum": [
              "HOT",
              "WARM",
              "COLD"
            ]
          },
          "ownerId": {
            "type": "string"
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "gdprConsent": {
            "type": "boolean"
          },
          "ownerId": {
            "type": "string"
          },
          "companies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "companyId": {
                  "type": "string"
                },
                "companyName": {
                  "type": "string"
                },
                "jobTitle": {
                  "type": "string"
                },
                "isPrimary": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Opportunity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "stageId": {
            "type": "string"
          },
          "probability": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "WON",
              "LOST"
            ]
          },
          "ownerId": {
            "type": "string"
          },
          "teamMembers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "PRIMARY_OWNER",
                    "SALES_ENGINEER",
                    "ACCOUNT_EXECUTIVE",
                    "CUSTOMER_SUCCESS",
                    "EXECUTIVE_SPONSOR"
                  ]
                },
                "commissionShare": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate user and issue JWT pair",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "admin@clientsphere.io"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh access token using stored refresh token",
        "security": [],
        "responses": {
          "200": {
            "description": "Token refreshed"
          }
        }
      }
    },
