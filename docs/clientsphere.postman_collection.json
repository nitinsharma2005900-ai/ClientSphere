{
  "info": {
    "_postman_id": "c1a2b3c4-d5e6-7890-abcd-ef1234567890",
    "name": "ClientSphere Enterprise CRM API Collection",
    "description": "CRM API examples. Local endpoints are configured by default; no Railway live URL is available until account capacity is enabled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "",
      "type": "string"
    },
    {
      "key": "companyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "opportunityId",
      "value": "",
      "type": "string"
    },
    {
      "key": "webhookSecret",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Auth - Login as Administrator",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data.tokens) {",
              "    pm.collectionVariables.set('authToken', jsonData.data.tokens.accessToken);",
              "}",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has Access Token', function () { pm.expect(jsonData.data.tokens.accessToken).to.be.a('string'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@clientsphere.io\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "02. Auth - Get Profile (Me)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "03. Leads - List Paginated Leads",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/leads?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "leads"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "04. Leads - Create New Lead with Scoring",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data) {",
              "    pm.collectionVariables.set('leadId', jsonData.data.id);",
              "}",
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Seraphina\",\n  \"lastName\": \"Vance\",\n  \"email\": \"s.vance@solardynamics.com\",\n  \"phone\": \"+1-415-555-0182\",\n  \"companyName\": \"Solar Dynamics Inc\",\n  \"jobTitle\": \"Chief Operating Officer\",\n  \"source\": \"INBOUND_FORM\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/leads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "leads"
          ]
        }
      }
    },
